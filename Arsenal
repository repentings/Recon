    box.BackgroundColor3 = get() and COL_RED or Color3.fromRGB(42, 42, 50)
    box.BorderSizePixel = 0
    box.Parent = row
    corner(box, 9)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(14, 14)
    knob.Position = get() and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
    knob.BackgroundColor3 = COL_TEXT
    knob.BorderSizePixel = 0
    knob.Parent = box
    corner(knob, 7)

    row.MouseButton1Click:Connect(function()
        set(not get())
        local on = get()
        TweenService:Create(box, TweenInfo.new(0.14), {
            BackgroundColor3 = on and COL_RED or Color3.fromRGB(42, 42, 50)
        }):Play()
        TweenService:Create(knob, TweenInfo.new(0.14), {
            Position = on and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
        }):Play()
    end)
    return 36
end

local function makeSlider(parent, y, text, min, max, get, set, fmt)
    fmt = fmt or "%.2f"
    local hold = Instance.new("Frame")
    hold.Size = UDim2.new(1, -12, 0, 48)
    hold.Position = UDim2.fromOffset(0, y)
    hold.BackgroundColor3 = COL_CARD
    hold.BorderSizePixel = 0
    hold.Parent = parent
    corner(hold, 7)
    stroke(hold, Color3.fromRGB(36, 36, 44), 1)

    local lbl = Instance.new("TextLabel")
    lbl.BackgroundTransparency = 1
    lbl.Size = UDim2.new(1, -20, 0, 18)
    lbl.Position = UDim2.fromOffset(12, 6)
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 12
    lbl.TextColor3 = COL_TEXT
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Text = text .. ": " .. string.format(fmt, get())
    lbl.Parent = hold

    local barBG = Instance.new("Frame")
    barBG.Size = UDim2.new(1, -24, 0, 7)
    barBG.Position = UDim2.fromOffset(12, 30)
    barBG.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
    barBG.BorderSizePixel = 0
    barBG.Parent = hold
    corner(barBG, 3)

    local fill = Instance.new("Frame")
    local pct = math.clamp((get() - min) / (max - min), 0, 1)
    fill.Size = UDim2.new(pct, 0, 1, 0)
    fill.BackgroundColor3 = COL_RED
    fill.BorderSizePixel = 0
    fill.Parent = barBG
    corner(fill, 3)

    local sliding = false
    local function update(x)
        local rel = math.clamp((x - barBG.AbsolutePosition.X) / math.max(barBG.AbsoluteSize.X, 1), 0, 1)
        local val = min + (max - min) * rel
        set(val)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        lbl.Text = text .. ": " .. string.format(fmt, val)
    end
    barBG.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            sliding = true
            update(i.Position.X)
        end
    end)
    hold.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            sliding = true
            update(i.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            sliding = false
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if sliding and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            update(i.Position.X)
        end
    end)
    return 54
end

