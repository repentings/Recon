-- ========== SMOOTH FADE + LOADING ==========
local function showLoading()
    local fadeGui = Instance.new("ScreenGui")
    fadeGui.Name = "ReconFade"
    fadeGui.IgnoreGuiInset = true
    fadeGui.DisplayOrder = 1000
    fadeGui.ResetOnSpawn = false
    fadeGui.Parent = Parent

    -- full-screen veil: starts clear, eases to semi-transparent black (NOT pure black)
    local veil = Instance.new("Frame")
    veil.Name = "Veil"
    veil.Size = UDim2.fromScale(1, 1)
    veil.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    veil.BackgroundTransparency = 1 -- start fully see-through
    veil.BorderSizePixel = 0
    veil.Parent = fadeGui

    -- smooth world dim (optional blur)
    local blur = Instance.new("BlurEffect")
    blur.Name = "ReconBlur"
    blur.Size = 0
    blur.Parent = Lighting

    -- animate veil + blur in
    local fadeIn = TweenService:Create(veil, TweenInfo.new(1.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        BackgroundTransparency = 0.35 -- semi see-through black outside the card
    })
    local blurIn = TweenService:Create(blur, TweenInfo.new(1.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = 12
    })
    fadeIn:Play()
    blurIn:Play()
    fadeIn.Completed:Wait()

    -- loading card (solid, rounded) on top of the veil
    local card = Instance.new("Frame")
    card.AnchorPoint = Vector2.new(0.5, 0.5)
    card.Position = UDim2.fromScale(0.5, 0.5)
    card.Size = UDim2.fromOffset(480, 390)
    card.BackgroundColor3 = COL_BG
    card.BackgroundTransparency = 1
    card.BorderSizePixel = 0
    card.Parent = fadeGui
    corner(card, 16)
    local cardStroke = stroke(card, COL_RED, 1.2, 1)

    local ascii = Instance.new("TextLabel")
    ascii.BackgroundTransparency = 1
    ascii.Size = UDim2.new(1, -36, 1, -78)
    ascii.Position = UDim2.fromOffset(18, 14)
    ascii.Font = Enum.Font.Code
    ascii.TextSize = 10
    ascii.TextColor3 = COL_ASCII
    ascii.TextTransparency = 1
    ascii.TextXAlignment = Enum.TextXAlignment.Center
    ascii.TextYAlignment = Enum.TextYAlignment.Center
    ascii.Text = ASCII_EYE
    ascii.Parent = card

    local credit = Instance.new("TextLabel")
    credit.BackgroundTransparency = 1
    credit.Size = UDim2.new(1, 0, 0, 16)
    credit.Position = UDim2.new(0, 0, 1, -48)
    credit.Font = Enum.Font.Gotham
    credit.TextSize = 11
    credit.TextColor3 = COL_RED
    credit.TextTransparency = 1
    credit.Text = "made by poetry"
    credit.Parent = card

    local barBG = Instance.new("Frame")
    barBG.AnchorPoint = Vector2.new(0.5, 1)
    barBG.Position = UDim2.new(0.5, 0, 1, -16)
    barBG.Size = UDim2.new(0.72, 0, 0, 5)
    barBG.BackgroundColor3 = Color3.fromRGB(30, 30, 36)
    barBG.BackgroundTransparency = 1
    barBG.BorderSizePixel = 0
    barBG.Parent = card
    corner(barBG, 3)

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(0, 0, 1, 0)
    bar.BackgroundColor3 = COL_RED_BRIGHT
    bar.BorderSizePixel = 0
    bar.Parent = barBG
    corner(bar, 3)

    -- card fade in
    TweenService:Create(card, TweenInfo.new(0.45, Enum.EasingStyle.Quad), {BackgroundTransparency = 0}):Play()
    TweenService:Create(cardStroke, TweenInfo.new(0.45), {Transparency = 0}):Play()
    TweenService:Create(ascii, TweenInfo.new(0.55), {TextTransparency = 0}):Play()
    TweenService:Create(credit, TweenInfo.new(0.55), {TextTransparency = 0}):Play()
    TweenService:Create(barBG, TweenInfo.new(0.45), {BackgroundTransparency = 0}):Play()
    task.wait(0.35)

    -- 5s load bar
    local barTween = TweenService:Create(bar, TweenInfo.new(5, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), {
        Size = UDim2.new(1, 0, 1, 0)
    })
    barTween:Play()
    barTween.Completed:Wait()

    -- exit: card out, veil stays lightly tinted then clears fully
    TweenService:Create(card, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        BackgroundTransparency = 1,
        Size = UDim2.fromOffset(460, 370)
    }):Play()
    TweenService:Create(ascii, TweenInfo.new(0.3), {TextTransparency = 1}):Play()
    TweenService:Create(credit, TweenInfo.new(0.3), {TextTransparency = 1}):Play()
    TweenService:Create(barBG, TweenInfo.new(0.3), {BackgroundTransparency = 1}):Play()
    TweenService:Create(cardStroke, TweenInfo.new(0.3), {Transparency = 1}):Play()
    task.wait(0.35)

    local fadeOut = TweenService:Create(veil, TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        BackgroundTransparency = 1
    })
    local blurOut = TweenService:Create(blur, TweenInfo.new(0.55), {Size = 0})
    fadeOut:Play()
    blurOut:Play()
    fadeOut.Completed:Wait()
    blur:Destroy()
    fadeGui:Destroy()
end

