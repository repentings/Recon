local function corner(inst, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 8)
    c.Parent = inst
    return c
end

local function stroke(inst, col, t, trans)
    local s = Instance.new("UIStroke")
    s.Color = col or COL_RED
    s.Thickness = t or 1
    s.Transparency = trans or 0
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = inst
    return s
end

local function hopText(label)
    local text = label:GetAttribute("BaseText") or label.Text
    label:SetAttribute("BaseText", text)
    if label:GetAttribute("Hopping") then return end
    label:SetAttribute("Hopping", true)
    task.spawn(function()
        for i = 1, #text do
            local built = ""
            for j = 1, #text do
                local ch = text:sub(j, j)
                if j == i then
                    built = built .. '<font color="#FF2A35">' .. ch .. "</font>"
                else
                    built = built .. ch
                end
            end
            label.RichText = true
            label.Text = built
            task.wait(0.028)
        end
        label.Text = text
        label:SetAttribute("Hopping", false)
    end)
end

