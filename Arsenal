-- ========== AIMBOT CORE ==========
local function keyDown()
    local k = State.AimKey
    if typeof(k) == "EnumItem" then
        if k.EnumType == Enum.UserInputType then
            return UserInputService:IsMouseButtonPressed(k)
        else
            return UserInputService:IsKeyDown(k)
        end
    end
    return false
end

local function isVisible(part)
    if not State.VisCheck then return true end
    local origin = Camera.CFrame.Position
    local dir = (part.Position - origin)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {LocalPlayer.Character, part.Parent}
    params.IgnoreWater = true
    local hit = workspace:Raycast(origin, dir, params)
    if not hit then return true end
    return hit.Instance and hit.Instance:IsDescendantOf(part.Parent)
end

local function getTargetPart(char)
    return char:FindFirstChild(State.AimPart) or char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
end

local function scoreTarget(plr, part, mid)
    local sp, on = Camera:WorldToViewportPoint(part.Position)
    if not on or sp.Z <= 0 then return nil end
    local screenDist = (Vector2.new(sp.X, sp.Y) - mid).Magnitude
    if screenDist > State.FOV then return nil end
    local worldDist = (part.Position - Camera.CFrame.Position).Magnitude
    if worldDist > State.MaxDist then return nil end
    if not isVisible(part) then return nil end

    local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
    local health = hum and hum.Health or 100

    if State.Priority == "Crosshair" then
        return screenDist, screenDist
    elseif State.Priority == "Distance" then
        return worldDist, screenDist
    else -- Health
        return health, screenDist
    end
end

local function validateLock(part)
    if not part or not part.Parent then return false end
    local char = part.Parent
    local plr = Players:GetPlayerFromCharacter(char)
    if not plr or plr == LocalPlayer then return false end
    if State.TeamCheck and plr.Team and LocalPlayer.Team and plr.Team == LocalPlayer.Team then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    local mid = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local sc = select(1, scoreTarget(plr, part, mid))
    return sc ~= nil
end

local function getClosest()
    local mid = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)

    if State.Sticky and LockedTarget and validateLock(LockedTarget) then
        return LockedTarget
    end
    LockedTarget = nil

    local bestPart, bestScore = nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local teamSkip = State.TeamCheck and plr.Team and LocalPlayer.Team and plr.Team == LocalPlayer.Team
            if not teamSkip then
                local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                local part = getTargetPart(plr.Character)
                if part and hum and hum.Health > 0 then
                    local score = scoreTarget(plr, part, mid)
                    if score ~= nil and score < bestScore then
                        bestScore = score
                        bestPart = part
                    end
                end
            end
        end
    end
    if bestPart then LockedTarget = bestPart end
    return bestPart
end

local function predictPos(part)
    if not State.Prediction then return part.Position end
    local v = part.AssemblyLinearVelocity
    if not v then
        local root = part.Parent and part.Parent:FindFirstChild("HumanoidRootPart")
        v = root and root.AssemblyLinearVelocity or Vector3.zero
    end
    return part.Position + (v * State.PredictAmount)
end

RunService.RenderStepped:Connect(function()
    if not (State.Aimbot and keyDown()) then
        if not keyDown() then LockedTarget = nil end
        return
    end
    local part = getClosest()
    if not part then return end

    local aimAt = predictPos(part)
    if State.Humanize then
        local h = State.HumanizeAmount
        aimAt = aimAt + Vector3.new(
            (math.noise(os.clock() * 1.7) - 0.5) * h,
            (math.noise(os.clock() * 2.1 + 10) - 0.5) * h * 0.6,
            (math.noise(os.clock() * 1.3 + 20) - 0.5) * h
        )
    end

    local targetCF = CFrame.new(Camera.CFrame.Position, aimAt)
    local alpha = math.clamp(1 - State.Smooth, 0.04, 1)
    Camera.CFrame = Camera.CFrame:Lerp(targetCF, alpha)
end)

-- ========== CHAMS ==========
local function clearChams()
    ChamsFolder:ClearAllChildren()
end

local function applyChams()
    clearChams()
    if not State.Chams and not State.ESPName then return end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local teamSkip = State.TeamCheck and plr.Team and LocalPlayer.Team and plr.Team == LocalPlayer.Team
            if not teamSkip then
                if State.Chams then
                    if State.ChamsMode == "Highlight" then
                        local h = Instance.new("Highlight")
                        h.FillColor = State.ChamsFill
                        h.OutlineColor = State.ChamsOutline
                        h.FillTransparency = 0.55
                        h.OutlineTransparency = 0
                        h.Adornee = plr.Character
                        h.Parent = ChamsFolder
                    else
                        local head = plr.Character:FindFirstChild("Head")
                        if head then
                            local bb = Instance.new("BillboardGui")
                            bb.Adornee = head
                            bb.Size = UDim2.fromOffset(11, 11)
                            bb.AlwaysOnTop = true
                            bb.Parent = ChamsFolder
                            local f = Instance.new("Frame")
                            f.Size = UDim2.fromScale(1, 1)
                            f.BackgroundColor3 = COL_RED_BRIGHT
                            f.BorderSizePixel = 0
                            f.Parent = bb
                            corner(f, 2)
                        end
                    end
                end
                if State.ESPName then
                    local head = plr.Character:FindFirstChild("Head")
                    if head then
                        local bb = Instance.new("BillboardGui")
                        bb.Adornee = head
                        bb.Size = UDim2.fromOffset(120, 18)
                        bb.StudsOffset = Vector3.new(0, 1.6, 0)
                        bb.AlwaysOnTop = true
                        bb.Parent = ChamsFolder
                        local t = Instance.new("TextLabel")
                        t.BackgroundTransparency = 1
                        t.Size = UDim2.fromScale(1, 1)
                        t.Font = Enum.Font.GothamBold
                        t.TextSize = 12
                        t.TextColor3 = COL_RED_BRIGHT
                        t.TextStrokeTransparency = 0.5
                        t.Text = plr.Name
                        t.Parent = bb
                    end
                end
            end
        end
    end
end

